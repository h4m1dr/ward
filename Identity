### 8.4. Module: Telegram Mini App (TMA) Bridge
**Purpose:** Native integration with Telegram WebApp SDK for haptics, theming, and back-button handling.

**Implementation:** `js/core/tma-bridge.js`
```javascript
class TMABridge {
  constructor() {
    this.isTMA = window.Telegram && window.Telegram.WebApp;
    this.webApp = this.isTMA ? window.Telegram.WebApp : null;
    
    if (this.isTMA) {
      this.init();
    }
  }

  init() {
    // Expand to full screen
    this.webApp.expand();
    
    // Sync Theme Colors
    this.syncTheme();
    
    // Handle Back Button
    this.webApp.BackButton.onClick(() => {
      WARD_EVENTS.emit('ui:navigate_back');
    });
    
    // Ready Signal
    this.webApp.ready();
    
    console.log('[TMA] Initialized', this.webApp.initDataUnsafe);
  }

  syncTheme() {
    const tgParams = this.webApp.themeParams;
    if (tgParams.bg_color) {
      document.documentElement.style.setProperty('--bg-base', tgParams.bg_color);
    }
    if (tgParams.text_color) {
      document.documentElement.style.setProperty('--text-main', tgParams.text_color);
    }
    // Map TG colors to WARD palette where applicable
  }

  // Haptic Feedback Helpers
  haptic(type = 'light') {
    if (!this.isTMA) return;
    const HapticFeedback = this.webApp.HapticFeedback;
    
    switch(type) {
      case 'success': HapticFeedback.notificationOccurred('success'); break;
      case 'error': HapticFeedback.notificationOccurred('error'); break;
      case 'warning': HapticFeedback.notificationOccurred('warning'); break;
      case 'heavy': HapticFeedback.impactOccurred('heavy'); break;
      case 'medium': HapticFeedback.impactOccurred('medium'); break;
      case 'light': 
      default: HapticFeedback.impactOccurred('light'); break;
    }
  }

  showAlert(message) {
    if (this.isTMA) {
      this.webApp.showAlert(message);
    } else {
      alert(message);
    }
  }

  showConfirm(message, callback) {
    if (this.isTMA) {
      this.webApp.showConfirm(message, callback);
    } else {
      callback(confirm(message));
    }
  }
}

window.WARD_TMA = new TMABridge();

// Usage in controllers
