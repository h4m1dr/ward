### 8.2. Module: Global Event Bus & State Sync
**Purpose:** Decouple components so Process Tab can trigger Notification Bell update without direct DOM manipulation. Central nervous system of WARD.

**Implementation:** `js/core/event-bus.js`
```javascript
class WARDEventBus {
  constructor() {
    this.listeners = {};
  }

  on(event, callback) {
    if (!this.listeners[event]) this.listeners[event] = [];
    this.listeners[event].push(callback);
    return () => this.off(event, callback); // Unsubscribe function
  }

  off(event, callback) {
    if (!this.listeners[event]) return;
    this.listeners[event] = this.listeners[event].filter(cb => cb !== callback);
  }

  emit(event, data) {
    if (!this.listeners[event]) return;
    this.listeners[event].forEach(cb => {
      try { cb(data); } catch (e) { console.error(`EventBus error in ${event}`, e); }
    });
  }
}

// Global Instance
window.WARD_EVENTS = new WARDEventBus();

// Standard Event Types
