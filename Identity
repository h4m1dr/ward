function checkDirtyState() {
  const currentFormState = collectFormData();
  const isDirty = JSON.stringify(currentFormState) !== initialConfigSnapshot;
  
  if (isDirty !== WARD_STATE.settings.hasUnsavedChanges) {
    WARD_STATE.settings.hasUnsavedChanges = isDirty;
    updateSaveButtonState();
    
