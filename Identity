**React-like Error Boundary (Vanilla JS - Memory Safe):**
```javascript
class ComponentErrorBoundary {
  constructor(containerId, componentName) {
    this.container = document.getElementById(containerId);
    this.componentName = componentName;
    // Store original content ONLY IF necessary for rollback, otherwise rely on re-fetch
    this.originalContent = null; 
    this.errorCount = 0;
    this.maxErrorsBeforeHardStop = 5; // Prevent infinite error loops
  }

  wrap(asyncFn) {
    return async (...args) => {
      try {
        return await asyncFn(...args);
      } catch (error) {
        this.handleError(error);
        throw error; // Re-throw for global logging
      }
    };
  }

  handleError(error) {
    this.errorCount++;
    console.error(`[${this.componentName}] Critical Failure (#${this.errorCount})`, error);
    
    if (this.errorCount >= this.maxErrorsBeforeHardStop) {
      this.renderHardStop();
      return;
    }

    // Replace container with friendly error message
    // IMPORTANT: Clear innerHTML first to remove old event listeners/DOM nodes
    this.container.innerHTML = ''; 
    
    const errorCard = document.createElement('div');
    errorCard.className = 'error-boundary-card';
    errorCard.innerHTML = `
      <div class="error-icon">⚠️</div>
      <h3>${this.componentName} Unavailable</h3>
      <p class="text-muted">${error.message || 'An unexpected error occurred.'}</p>
      <div class="error-actions">
        <button class="btn-secondary retry-btn">Retry Operation</button>
        <button class="btn-ghost dismiss-btn">Dismiss</button>
      </div>
      <details class="error-details">
        <summary>Technical Details</summary>
        <pre class="mono small">${error.stack || 'No stack trace'}</pre>
      </details>
    `;
    
    this.container.appendChild(errorCard);

    // Bind Retry Logic
    errorCard.querySelector('.retry-btn').onclick = () => {
      this.errorCount = 0; // Reset counter
      this.container.innerHTML = '<div class="loading-spinner"></div>';
      // Trigger parent controller to re-init/fetch
      WARD_EVENTS.emit('component:retry', { name: this.componentName });
    };

    // Send to Event Engine
    WARD_EVENTS.emit('alert:new', {
      severity: 'crit',
      title: `${this.componentName} Crash`,
      message: error.message
    });
  }

  renderHardStop() {
    this.container.innerHTML = `
      <div class="error-hard-stop">
        <h3>System Instability Detected</h3>
        <p>Multiple failures occurred in ${this.componentName}. Please refresh the page.</p>
        <button class="btn-danger" onclick="location.reload()">Force Reload</button>
      </div>
    `;
  }
}

