**A. Idle Detection Logic (Frontend + Backend Hybrid):**
Backend calculates `idle_minutes` based on `established_count` history. Frontend visualizes it.
```javascript
updatePortStatus(row, data) {
  const badge = row.querySelector('.col-status .badge');
  
  if (data.state !== 'LISTEN') {
    badge.className = 'badge status-crit';
    badge.innerText = 'Down';
    WARD_EVENTS.log('crit', 'Port Down', `Port ${data.port}/${data.protocol} stopped listening`, 'ports');
  } else if (data.idle_minutes >= WARD_STATE.ports.idleThresholdMinutes) {
    badge.className = 'badge status-idle';
    badge.innerText = `Idle (${data.idle_minutes}m)`;
    // Optional: Warn only once per idle session
    if (!row.dataset.idleWarned) {
      WARD_EVENTS.log('warn', 'Proxy Idle', `Port ${data.port} has no active connections for ${data.idle_minutes}m`, 'ports');
      row.dataset.idleWarned = 'true';
    }
  } else {
    badge.className = 'badge status-active';
    badge.innerText = 'Active';
    row.dataset.idleWarned = ''; // Reset warning flag
  }
}
```

**B. Sparkline Rendering (Canvas):**
Lightweight canvas drawing for traffic flow without heavy chart libraries.
```javascript
drawSparkline(canvasId, dataBuffer) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;
  
  ctx.clearRect(0, 0, w, h);
  
  if (dataBuffer.length < 2) return;
  
  const maxVal = Math.max(...dataBuffer, 1); // Prevent div by zero
  
  ctx.beginPath();
  ctx.strokeStyle = '#06B6D4'; // --accent-flow
  ctx.lineWidth = 1.5;
  
  dataBuffer.forEach((val, i) => {
    const x = (i / (dataBuffer.length - 1)) * w;
    const y = h - ((val / maxVal) * (h - 4)) - 2; // 2px padding
    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  });
  
  ctx.stroke();
  
  // Fill area under line
  ctx.lineTo(w, h);
  ctx.lineTo(0, h);
  ctx.closePath();
  ctx.fillStyle = 'rgba(6, 182, 212, 0.1)';
  ctx.fill();
}
```

**C. Owner Process Resolution:**
Backend uses `ss -tulpn` or reads `/proc/net/tcp` + `/proc/{pid}/fd` symlinks to map inode -> PID -> Process Name.
```python
def resolve_port_owner(port, proto):
    try:
        # Fast method: ss command
        cmd = f"ss -{proto[0]}lnp sport = :{port}"
        res = subprocess.run(cmd.split(), capture_output=True, text=True, timeout=2)
        for line in res.stdout.splitlines():
            if 'users:' in line:
                # Parse users:(("nginx",pid=1234,fd=6))
                match = re.search(r'\("([^"]+)",pid=(\d+)', line)
                if match:
                    return match.group(1), int(match.group(2))
    except Exception:
        pass
    
    # Fallback: Scan /proc/net/tcp
    # ... (inode lookup logic) ...
    return "unknown", None
```

