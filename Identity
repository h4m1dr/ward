### 2.9. JavaScript Logic: Overview Controller
**File:** `js/controllers/overview.js`
**Key Functions:**
```javascript
class OverviewController {
  constructor() {
    this.charts = {};
    // Ring buffer strictly enforced to 60 items (60 seconds at 1s poll)
    this.dataBuffer = { cpu: [], mem: [], net: [], conn: [] }; 
    this.maxBufferSize = 60; 
  }

  init() {
    this.initCharts();
    this.startPolling();
    this.bindEvents();
  }

  async fetchData() {
    // LAW #5 Compliance: Do not fetch or render if tab is hidden
    if (WARD_STATE.isPaused || document.hidden) return;
    
    try {
      const res = await fetch('/api/telemetry/overview');
      const data = await res.json();
      this.updateDOM(data);
      this.pushToBuffer(data);
      this.renderCharts(); // Only renders if visible
      this.checkThresholds(data);
    } catch (e) {
      console.error("Overview fetch failed", e);
      WARD_UI.showConnectionError();
    }
  }

  updateDOM(data) {
    // Update CPU
    document.getElementById('cpu-percent').innerText = data.cpu.total_percent.toFixed(1);
    document.getElementById('cpu-iowait').innerText = data.cpu.iowait_percent.toFixed(1) + '%';
    this.updateStatusBadge('card-cpu', data.cpu.total_percent, [70, 90]);

    // Update Memory
    const memPct = (data.memory.used_bytes / data.memory.total_bytes) * 100;
    document.getElementById('mem-bar').style.width = memPct + '%';
    document.getElementById('mem-used').innerText = (data.memory.used_bytes / 1e9).toFixed(1);
    
    // Update Disk Gauge
    const diskPct = (data.disk.used_bytes / data.disk.total_bytes) * 100;
    this.drawGauge('gauge-disk-space', diskPct);
    document.getElementById('disk-read-speed').innerText = (data.disk.read_bytes_sec / 1e6).toFixed(1) + ' MB/s';

    // Update Network
    document.getElementById('net-tx-speed').innerText = (data.network.interfaces.eth0.tx_bytes_sec / 1e6).toFixed(1);
    document.getElementById('net-rx-speed').innerText = (data.network.interfaces.eth0.rx_bytes_sec / 1e6).toFixed(1);

    // Update Connections
    document.getElementById('conn-total').innerText = data.connections.total_sockets;
    document.getElementById('conn-tcp-est').innerText = data.connections.tcp_established;
  }

  checkThresholds(data) {
    if (data.cpu.iowait_percent > 20) {
      WARD_EVENTS.log('warn', 'High IO Wait', 'Disk bottleneck detected (>20%)');
    }
    if (data.disk.used_bytes / data.disk.total_bytes > 0.9) {
      WARD_EVENTS.log('crit', 'Disk Full', 'Storage usage exceeded 90%');
      document.getElementById('btn-clean-cache').style.display = 'block';
    }
  }
  
  pushToBuffer(data) {
    // Enforce Ring Buffer Limit (LAW #5)
    const pushAndTrim = (arr, val) => {
      arr.push(val);
      if (arr.length > this.maxBufferSize) arr.shift();
    };
    
    pushAndTrim(this.dataBuffer.cpu, data.cpu.total_percent);
    pushAndTrim(this.dataBuffer.mem, data.memory.used_bytes);
    pushAndTrim(this.dataBuffer.net, data.network.interfaces.eth0.rx_bytes_sec);
    pushAndTrim(this.dataBuffer.conn, data.connections.total_sockets);
  }
}
```

### 2.10. Module: Lightweight Canvas Chart Engine (IMMUTABLE LAW)
**Purpose:** Zero-dependency graphs to maintain <50KB payload and instant load times.
