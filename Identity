import os

# HARD-CODED DENY LIST (Never allow cleaning these paths)
CRITICAL_SYSTEM_PATHS = [
    '/', '/etc', '/usr', '/bin', '/sbin', '/lib', '/lib64', 
    '/boot', '/proc', '/sys', '/dev', '/run'
]

def validate_cleanup_path(path):
    """Ensures path is not a critical system directory."""
    real_path = os.path.realpath(path)
    
    # Check exact match or prefix match (e.g., /usr/local matches /usr)
    for denied in CRITICAL_SYSTEM_PATHS:
        if real_path == denied or real_path.startswith(denied + '/'):
            raise PermissionError(f"Access Denied: Cannot clean critical system path '{real_path}'")
            
    return real_path

CLEANUP_RULES = {
  'old_logs': {
    'pattern': r'.*\.(gz|old|\d+)$',
    'min_age_days': 7,
    'safe': True
  },
  'empty_files': {
    'pattern': r'.*',
    'max_size_bytes': 0,
    'safe': True
  },
  'all_logs': {
    'pattern': r'.*\.log$',
    'safe': False, # Requires double confirmation
