**A. Render & Update Loop:**
```javascript
class ServiceController {
  async fetchAndRender() {
    const res = await fetch('/api/services/list');
    const data = await res.json();
    
    // Update Summary Badges
    document.getElementById('count-active').innerText = data.summary.active;
    document.getElementById('count-failed').innerText = data.summary.failed;
    
    // Apply Filters
    let filtered = data.units;
    if (WARD_STATE.services.filterStatus !== 'all') {
      filtered = filtered.filter(u => u.active_state === WARD_STATE.services.filterStatus);
    }
    if (WARD_STATE.services.searchQuery) {
      const q = WARD_STATE.services.searchQuery.toLowerCase();
      filtered = filtered.filter(u => 
        u.name.toLowerCase().includes(q) || 
        u.description.toLowerCase().includes(q)
      );
    }
    
    this.renderTable(filtered);
  }

  renderTable(units) {
    const tbody = document.getElementById('svc-tbody');
    // Diffing algorithm to update only changed rows (prevent flickering)
    units.forEach(unit => {
      let row = document.querySelector(`tr[data-unit="${unit.name}"]`);
      if (!row) {
        row = this.createRowElement(unit);
        tbody.appendChild(row);
      }
      this.updateRowElement(row, unit);
    });
    
    // Remove rows that no longer exist
    const currentUnits = new Set(units.map(u => u.name));
    Array.from(tbody.querySelectorAll('.svc-row')).forEach(row => {
      if (!currentUnits.has(row.dataset.unit)) row.remove();
    });
  }

  updateRowElement(row, unit) {
    // Update Status Dot Color
    const dot = row.querySelector('.status-dot');
    dot.className = `status-dot large status-${unit.active_state}`;
    
    // Update State Text
    row.querySelector('.state-active').innerText = unit.active_state;
    row.querySelector('.state-sub').innerText = unit.sub_state;
    
    // Update Auto-Recover Checkbox (without triggering event if unchanged)
    const toggle = row.querySelector('.autorecover-toggle');
    if (toggle.checked !== unit.auto_recovery) {
      toggle.checked = unit.auto_recovery;
    }
    
    // Enable/Disable buttons based on state AND protection status
    const btnStart = row.querySelector('[data-action="start"]');
    const btnStop = row.querySelector('[data-action="stop"]');
    const btnRestart = row.querySelector('[data-action="restart"]');
    
    const isProtected = unit.is_protected;
    
    btnStart.disabled = (unit.active_state === 'active') || isProtected;
    btnStop.disabled = (unit.active_state !== 'active') || isProtected;
    btnRestart.disabled = isProtected;
    
    if (isProtected) {
      btnStart.title = "Protected System Service";
      btnStop.title = "Protected System Service";
      btnRestart.title = "Protected System Service";
    }
  }
  
  bindControlEvents() {
    document.getElementById('svc-tbody').addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-ctrl');
      if (!btn) return;
      
      const unit = btn.closest('.svc-row').dataset.unit;
      const action = btn.dataset.action;
      
      if (action === 'logs') {
        toggleLogs(unit);
      } else {
        this.executeAction(unit, action);
      }
    });
    
    // Auto-Recover Toggle Change
    document.getElementById('svc-tbody').addEventListener('change', (e) => {
      if (e.target.classList.contains('autorecover-toggle')) {
        const unit = e.target.closest('.svc-row').dataset.unit;
        const enabled = e.target.checked;
        this.updateConfig(unit, { auto_recovery: enabled });
      }
    });
  }

  async executeAction(unit, action) {
    // Confirmation for destructive actions
    if (action === 'stop' && !confirm(`Stop ${unit}? This may take services offline.`)) return;
    
    try {
      const res = await fetch('/api/services/action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Session-Token': sessionToken },
        body: JSON.stringify({ unit, action })
      });
      const result = await res.json();
      if (result.success) {
        showToast(`${action.toUpperCase()} command sent to ${unit}`, 'success');
        this.fetchAndRender(); // Immediate refresh
      } else {
        showToast(`Failed: ${result.error}`, 'error');
      }
    } catch (e) {
      showToast('Network error executing action', 'error');
    }
  }
}
```

