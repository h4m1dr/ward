### 8.3. Module: Error Boundary & Graceful Degradation
**Purpose:** Prevent white-screen-of-death when one component fails. Isolate errors per tab.

**React-like Error Boundary (Vanilla JS):**
```javascript
class ComponentErrorBoundary {
  constructor(containerId, componentName) {
    this.container = document.getElementById(containerId);
    this.componentName = componentName;
    this.originalContent = this.container.innerHTML;
  }

  wrap(asyncFn) {
    return async (...args) => {
      try {
        return await asyncFn(...args);
      } catch (error) {
        this.handleError(error);
        throw error; // Re-throw for global logging
      }
    };
  }

  handleError(error) {
    console.error(`[${this.componentName}] Critical Failure`, error);
    
    // Replace container with friendly error message
    this.container.innerHTML = `
      <div class="error-boundary-card">
        <div class="error-icon">⚠️</div>
        <h3>${this.componentName} Unavailable</h3>
        <p class="text-muted">${error.message || 'An unexpected error occurred.'}</p>
        <div class="error-actions">
          <button class="btn-secondary" onclick="location.reload()">Reload Page</button>
          <button class="btn-ghost" onclick="this.closest('.error-boundary-card').remove()">Dismiss</button>
        </div>
        <details class="error-details">
          <summary>Technical Details</summary>
          <pre class="mono small">${error.stack || 'No stack trace'}</pre>
        </details>
      </div>
    `;
    
    // Send to Event Engine
    WARD_EVENTS.emit('alert:new', {
      severity: 'crit',
      title: `${this.componentName} Crash`,
      message: error.message
    });
  }
}

// Usage in init
const overviewBoundary = new ComponentErrorBoundary('overview-grid', 'Overview Dashboard');
const safeFetchOverview = overviewBoundary.wrap(OverviewController.fetchData.bind(OverviewController));
