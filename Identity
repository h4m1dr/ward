    document.querySelectorAll('.proc-row').forEach(r => r.draggable = true);
    this.disableHeaderSorting();
    this.initDragAndDrop();
  } else {
    // LOCKING: Save current visual order as permanent priority
    state.isLocked = true;
    this.saveOrderToBackend(); 
    
    const lockBtn = document.getElementById('btn-proc-lock');
    lockBtn.innerText = '🔒';
    lockBtn.title = 'Unlock to Reorder';
    
    document.querySelectorAll('.drag-handle').forEach(h => h.style.display = 'none');
    document.querySelectorAll('.proc-row').forEach(r => r.draggable = false);
    this.enableHeaderSorting();
    state.originalSnapshot = null; // Clear snapshot
  }
}

// TAB SWITCH SAFETY (Rollback Logic)
onTabSwitch() {
  const state = WARD_STATE.processes;
  if (!state.isLocked && state.originalSnapshot) {
    // User left tab while unlocked -> DISCARD CHANGES
    console.warn('[WARD] Tab switched while unlocked. Rolling back process order.');
    this.renderTable(state.originalSnapshot); // Restore original order
    state.isLocked = true; // Force lock
    state.originalSnapshot = null;
    this.updateLockButtonUI(true);
    showToast('Unsaved order changes discarded', 'info');
  }
}
```

**C. Auto-Pause on Interaction:**
```javascript
initAutoPause() {
  const tableWrapper = document.querySelector('.table-wrapper');
  
  const resumePolling = () => {
    clearTimeout(WARD_STATE.processes.pauseTimeout);
    WARD_STATE.processes.pauseTimeout = setTimeout(() => {
      WARD_STATE.processes.autoRefresh = true;
    }, 5000); // Resume after 5s of no interaction
  };
  
  const pausePolling = () => {
    WARD_STATE.processes.autoRefresh = false;
    clearTimeout(WARD_STATE.processes.pauseTimeout);
  };
  
  tableWrapper.addEventListener('scroll', pausePolling);
  tableWrapper.addEventListener('mousedown', pausePolling);
  tableWrapper.addEventListener('touchstart', pausePolling);
  
  // Auto-resume timer
  tableWrapper.addEventListener('scrollend', resumePolling);
  tableWrapper.addEventListener('mouseup', resumePolling);
  tableWrapper.addEventListener('touchend', resumePolling);
}
```

**D. Persistent Row ID Logic:**
*   When a process is first added to Watchlist, backend assigns a permanent `row_id` (incremental integer).
*   This `row_id` is stored in `config.json` under `watched_processes`.
*   Even if the process restarts (new PID), if the name matches, it retains the same `row_id` and thus the same position number in the UI.
*   If the process disappears temporarily, the row remains in the table with status "Stopped" (greyed out) to preserve layout stability.

