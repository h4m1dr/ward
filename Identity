### 3.7. JavaScript Logic: Process Controller
**File:** `js/controllers/processes.js`
**Key Algorithms:**

**A. Delta CPU Calculation (Fixing the "0% CPU" Bug):**
The backend must calculate CPU delta, not the frontend. However, the frontend must handle rapid updates smoothly.
```javascript
updateCpuDisplay(newData) {
  newData.forEach(proc => {
    const row = document.querySelector(`tr[data-pid="${proc.pid}"]`);
    if (!row) return;
    
    const cpuCell = row.querySelector('.cpu-val');
    const oldVal = parseFloat(cpuCell.dataset.lastVal || 0);
    const newVal = proc.cpu_percent;
    
    // Smooth transition animation for numbers
    this.animateValue(cpuCell, oldVal, newVal, 500);
    cpuCell.dataset.lastVal = newVal;
    
    // Color coding
    if (newVal > 80) cpuCell.style.color = 'var(--accent-crit)';
    else if (newVal > 50) cpuCell.style.color = 'var(--accent-warn)';
    else cpuCell.style.color = 'var(--text-main)';
  });
}
```

**B. Lock/Unlock & Drag-and-Drop Logic:**
```javascript
toggleLock() {
  const state = WARD_STATE.processes;
  state.isLocked = !state.isLocked;
  
  const lockBtn = document.getElementById('btn-proc-lock');
  const handles = document.querySelectorAll('.drag-handle');
  const rows = document.querySelectorAll('.proc-row');
  
  if (state.isLocked) {
    // LOCKED: Enable Sorting, Disable Drag
    lockBtn.innerText = '🔒';
    lockBtn.title = 'Unlock to Reorder';
    handles.forEach(h => h.style.display = 'none');
    rows.forEach(r => r.draggable = false);
    this.enableHeaderSorting();
    this.saveOrderToBackend(); // Persist current visual order as priority
  } else {
    // UNLOCKED: Disable Sorting, Enable Drag
    lockBtn.innerText = '🔓';
    lockBtn.title = 'Lock to Sort';
    handles.forEach(h => h.style.display = 'block');
    rows.forEach(r => r.draggable = true);
    this.disableHeaderSorting();
    this.initDragAndDrop();
  }
}

initDragAndDrop() {
  const tbody = document.getElementById('proc-tbody');
  let draggedRow = null;

  tbody.addEventListener('dragstart', (e) => {
    if (!e.target.closest('.proc-row')) return;
    draggedRow = e.target.closest('.proc-row');
    draggedRow.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
  });

  tbody.addEventListener('dragover', (e) => {
    e.preventDefault();
    const afterElement = this.getDragAfterElement(tbody, e.clientY);
    if (afterElement == null) {
      tbody.appendChild(draggedRow);
    } else {
      tbody.insertBefore(draggedRow, afterElement);
    }
  });

  tbody.addEventListener('dragend', () => {
    draggedRow.classList.remove('dragging');
    draggedRow = null;
    // Update internal state order based on DOM position
    this.updateRowPrioritiesFromDOM();
  });
}

getDragAfterElement(container, y) {
  const draggableElements = [...container.querySelectorAll('.proc-row:not(.dragging)')];
  return draggableElements.reduce((closest, child) => {
    const box = child.getBoundingClientRect();
    const offset = y - box.top - box.height / 2;
    if (offset < 0 && offset > closest.offset) {
      return { offset: offset, element: child };
    } else {
      return closest;
    }
  }, { offset: Number.NEGATIVE_INFINITY }).element;
}
```

**C. Persistent Row ID Logic:**
*   When a process is first added to Watchlist, backend assigns a permanent `row_id` (incremental integer).
*   This `row_id` is stored in `config.json` under `watched_processes`.
*   Even if the process restarts (new PID), if the name matches, it retains the same `row_id` and thus the same position number in the UI.
*   If the process disappears temporarily, the row remains in the table with status "Stopped" (greyed out) to preserve layout stability.

