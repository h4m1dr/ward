import asyncio
import aiohttp # Recommended async library
from concurrent.futures import ThreadPoolExecutor

class TelegramNotifier:
    def __init__(self, token, chat_id):
        self.token = token
        self.chat_id = chat_id
        self.api_url = f"https://api.telegram.org/bot{token}/sendMessage"
        self.executor = ThreadPoolExecutor(max_workers=2) # Limit concurrency

    async def send_async(self, message, severity='info'):
        """Non-blocking send using aiohttp"""
        if not self.token or not self.chat_id:
            return False
            
        icons = {'crit': '🚨', 'warn': '⚠️', 'info': '🔵'}
        icon = icons.get(severity, 'ℹ️')
        formatted_msg = f"<b>{icon} WARD Alert</b>\n\n{message}"
        
        payload = {
            'chat_id': self.chat_id,
            'text': formatted_msg,
            'parse_mode': 'HTML',
            'disable_web_page_preview': True
        }
        
        try:
            async with aiohttp.ClientSession() as session:
                async with session.post(self.api_url, json=payload, timeout=aiohttp.ClientTimeout(total=5)) as resp:
                    return resp.status == 200
        except Exception as e:
            print(f"[TG] Send Failed: {e}")
            return False

    def send_sync_wrapper(self, message, severity='info'):
        """Wrapper for synchronous contexts (if needed)"""
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        try:
            return loop.run_until_complete(self.send_async(message, severity))
        finally:
            loop.close()
            
    def get_updates(self, timeout=5):
        """Used for 'Detect My ID' feature"""
        url = f"https://api.telegram.org/bot{self.token}/getUpdates"
        try:
            # Use requests here as it's a one-time admin action, not high-frequency
            res = requests.get(url, timeout=timeout)
            data = res.json()
            if data.get('ok') and data.get('result'):
                last_msg = data['result'][-1]
                return last_msg['message']['chat']['id']
        except:
            pass
        return None
```

