**C. Threshold Validation:**
```javascript
function validateThresholds() {
  const rows = document.querySelectorAll('.threshold-table tbody tr');
  let isValid = true;
  
  rows.forEach(row => {
    const warnInput = row.querySelector('input:nth-of-type(1)');
    const critInput = row.querySelector('input:nth-of-type(2)');
    
    const warn = parseFloat(warnInput.value);
    const crit = parseFloat(critInput.value);
    
    if (warn >= crit) {
      warnInput.classList.add('input-error');
      critInput.classList.add('input-error');
      isValid = false;
    } else {
      warnInput.classList.remove('input-error');
      critInput.classList.remove('input-error');
    }
  });
  
  if (!isValid) {
    showToast('Warning threshold must be lower than Critical', 'error');
  }
  return isValid;
}
```

