### 6.8. JavaScript Logic: Storage Controller
**File:** `js/controllers/storage.js`
**Key Algorithms:**

**A. Treemap Rendering (Squarified Algorithm Simplified):**
```javascript
function drawTreemap(canvasId, data) {
  const canvas = document.getElementById(canvasId);
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;
  
  ctx.clearRect(0, 0, w, h);
  
  // Sort children by size descending
  const sorted = [...data.children].sort((a, b) => b.size - a.size);
  const total = data.total_size || 1;
  
  let x = 0, y = 0;
  const colors = ['#3B82F6', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6', '#EC4899'];
  
  // Simple slice-and-dice layout for performance
  sorted.forEach((item, i) => {
    const ratio = item.size / total;
    const rectW = w * ratio;
    
    ctx.fillStyle = colors[i % colors.length];
    ctx.fillRect(x, y, rectW - 2, h - 2); // 2px gap
    
    // Label if big enough
    if (rectW > 60 && h > 30) {
      ctx.fillStyle = '#FFF';
      ctx.font = '11px Inter';
      ctx.fillText(item.name.substring(0, 10), x + 5, y + 15);
      ctx.fillText((item.size / 1e6).toFixed(0) + 'MB', x + 5, y + 30);
    }
    
    // Store rect for hover detection
    item._rect = { x, y, w: rectW - 2, h: h - 2 };
    x += rectW;
  });
  
  // Hover interaction
  canvas.onmousemove = (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    
    const hovered = sorted.find(item => 
      mx >= item._rect.x && mx <= item._rect.x + item._rect.w &&
      my >= item._rect.y && my <= item._rect.y + item._rect.h
    );
    
    const tooltip = document.getElementById('treemap-tooltip');
    if (hovered) {
      tooltip.style.display = 'block';
      tooltip.style.left = (e.clientX + 10) + 'px';
      tooltip.style.top = (e.clientY + 10) + 'px';
      tooltip.innerHTML = `<strong>${hovered.name}</strong><br>${(hovered.size/1e6).toFixed(2)} MB`;
    } else {
      tooltip.style.display = 'none';
    }
  };
}
```

**B. Growth Rate Calculation:**
```javascript
calculateGrowthTrend(historyArray) {
  if (historyArray.length < 2) return { rate: 0, direction: 'stable' };
  
  const first = historyArray[0];
  const last = historyArray[historyArray.length - 1];
  const hours = historyArray.length;
  
  const ratePerHour = (last - first) / hours;
  
  let direction = 'stable';
  if (ratePerHour > 10 * 1024 * 1024) direction = 'growing_fast'; // >10MB/h
  else if (ratePerHour > 1 * 1024 * 1024) direction = 'growing';   // >1MB/h
  else if (ratePerHour < -1 * 1024 * 1024) direction = 'shrinking';
  
  return { rate: ratePerHour, direction };
}
```

**C. Smart Alert Thresholds:**
```javascript
checkStorageAlerts(partitions, folders) {
  partitions.forEach(p => {
    if (p.used_percent > 90) {
      WARD_EVENTS.log('crit', 'Disk Critical', `${p.mount_point} is ${p.used_percent}% full`, 'storage');
      document.getElementById(`alert-part-${p.mount_point}`).style.display = 'flex';
    } else if (p.used_percent > 80) {
      WARD_EVENTS.log('warn', 'Disk Warning', `${p.mount_point} is ${p.used_percent}% full`, 'storage');
    }
  });
  
  folders.forEach(f => {
    if (f.status === 'growing_fast') {
      WARD_EVENTS.log('warn', 'Log Bloat Detected', `${f.path} growing at ${(f.growth_rate_bytes_per_hour/1e6).toFixed(0)}MB/h`, 'storage');
    }
  });
}
```

