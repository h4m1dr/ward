**Log Stream Logic (JS):**
```javascript
let logEventSource = null;

function toggleLogs(unitName) {
  const logRow = document.getElementById(`logs-${unitName}`);
  const logContent = document.getElementById(`log-content-${unitName}`);
  const isVisible = logRow.style.display !== 'none';

  if (isVisible) {
    // Close
    logRow.style.display = 'none';
    if (logEventSource) { logEventSource.close(); logEventSource = null; }
    WARD_STATE.services.expandedLogs = null;
  } else {
    // Open
    // Close any other open logs first (accordion behavior)
    if (WARD_STATE.services.expandedLogs) {
      toggleLogs(WARD_STATE.services.expandedLogs);
    }
    
    logRow.style.display = 'table-row';
    logContent.innerText = 'Connecting to journal stream...';
    WARD_STATE.services.expandedLogs = unitName;

    // Start SSE Stream
    logEventSource = new EventSource(`/api/services/logs/${encodeURIComponent(unitName)}/stream?token=${sessionToken}`);
    
    logEventSource.onmessage = (event) => {
      const line = event.data;
      logContent.innerText += line + '\n';
      
      // Keep only last 100 lines in DOM to prevent memory leak
      const lines = logContent.innerText.split('\n');
      if (lines.length > 100) {
        logContent.innerText = lines.slice(-100).join('\n');
      }
      
      // Auto-scroll if near bottom
      const container = logContent.parentElement;
      if (container.scrollHeight - container.scrollTop <= container.clientHeight + 50) {
        container.scrollTop = container.scrollHeight;
      }
    };

    logEventSource.onerror = () => {
      logContent.innerText += '\n[Connection Lost. Retrying...]';
    };
  }
}
```

### 4.5. Component: Auto-Recovery Engine (Backend Logic)
**Feature:** If enabled, WARD monitors specific services and restarts them if they die unexpectedly.
**Configuration Storage:** `config.json` -> `auto_recovery_services: ["nginx.service", "xray.service"]`

**Backend Worker Thread (`service_guardian.py`):**
```python
import subprocess
import time
from collections import deque

class ServiceGuardian:
    def __init__(self, check_interval=10):
        self.check_interval = check_interval
        self.failure_counts = {} # Track consecutive failures to prevent restart loops
        self.max_failures_before_alert = 3
        
    def run_loop(self):
        while True:
            watched_services = load_config().get('auto_recovery_services', [])
            
            for unit in watched_services:
                status = self.get_service_status(unit)
                
                if status['active_state'] == 'failed' or status['sub_state'] == 'dead':
                    self.handle_failure(unit)
                else:
                    # Reset failure count if healthy
                    self.failure_counts[unit] = 0
                    
            time.sleep(self.check_interval)
            
    def get_service_status(self, unit):
        try:
            res = subprocess.run(
                ["systemctl", "show", unit, "--property=ActiveState,SubState", "--no-pager"],
                capture_output=True, text=True, timeout=5
            )
            props = dict(line.split('=') for line in res.stdout.strip().split('\n') if '=' in line)
            return {
                'active_state': props.get('ActiveState', 'unknown'),
                'sub_state': props.get('SubState', 'unknown')
            }
        except Exception:
            return {'active_state': 'error', 'sub_state': 'check_failed'}

    def handle_failure(self, unit):
        count = self.failure_counts.get(unit, 0) + 1
        self.failure_counts[unit] = count
        
        # Log Event
        EVENT_ENGINE.log('warn', 'Service Down', f'{unit} is inactive/dead. Attempting auto-restart ({count}/{self.max_failures_before_alert})', source='guardian')
        
        if count <= self.max_failures_before_alert:
            try:
                subprocess.run(["systemctl", "restart", unit], timeout=10)
                EVENT_ENGINE.log('info', 'Auto-Recovery', f'Successfully restarted {unit}', source='guardian')
            except Exception as e:
                EVENT_ENGINE.log('crit', 'Recovery Failed', f'Could not restart {unit}: {str(e)}', source='guardian')
        else:
            # Stop trying to prevent loop, alert admin
            EVENT_ENGINE.log('crit', 'Recovery Aborted', f'{unit} failed {count} times. Manual intervention required.', source='guardian')
            # Optionally disable auto-recovery for this unit in config
```

